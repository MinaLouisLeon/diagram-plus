{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diagram-plus",
  "version": "0.1.0",
  "identifier": "app.diagramplus.desktop",
  "build": {
    "frontendDist": "../../server/public",
    "devUrl": "http://localhost:4518",
    "beforeDevCommand": {
      "cwd": "../../..",
      "script": "npm run dev -w @diagram-plus/web"
    },
    "beforeBuildCommand": {
      "cwd": "../../..",
      "script": "npm run build -w @diagram-plus/web"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "diagram-plus",
        "width": 1400,
        "height": 900,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/mcp-server.mjs": "mcp-server.mjs"
    },
    "category": "DeveloperTool",
    "shortDescription": "Design your app as a block diagram",
    "longDescription": "diagram-plus is a visual editor for block diagrams that double as a machine-readable specification. Design your application as typed blocks and connections, then have Claude Code read the diagram and build it.",
    "copyright": "MIT",
    "publisher": "diagram-plus",
    "licenseFile": "../../../LICENSE",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
